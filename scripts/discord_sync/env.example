# このファイルを .env という名前でコピーして、空の項目を埋める
# .env と secrets/ は git に入れない

# Discord の Bot トークン
DISCORD_BOT_TOKEN=

# Discord サーバーのID
DISCORD_GUILD_ID=

# 申し込みを投稿するスタッフ専用チャンネル
STAFF_CHANNEL_LT=
STAFF_CHANNEL_COMMUNITY=
STAFF_CHANNEL_SPONSOR=

# 採択を知らせる一般向けチャンネル
# #lt登壇 と #community参加
PUBLIC_CHANNEL_LT=
PUBLIC_CHANNEL_COMMUNITY=

# 作業の記録を残すチャンネル
LOG_CHANNEL_ID=

# 本文で案内するチャンネル
CHANNEL_LT_TOUDAN=
CHANNEL_OSHIRASE=
CHANNEL_COMMUNITY_SANKA=

# スタッフ専用チャンネルの投稿で呼び出すロール
STAFF_ROLE_ID=

# 絵文字。カスタム絵文字は name:id の形。標準の絵文字はそのまま貼る
EMOJI_YOSASOU=yosasou:
EMOJI_HORYU=horyu:
EMOJI_MAIL_DONE=mail_done:
EMOJI_DISCORD_DONE=discord_done:
EMOJI_ROLE_DONE=role_done:
EMOJI_OK=🆗
EMOJI_OK_DONE=ok_done:

# 承認したときに付けるロール
# /ALL は年をまたいで残すもの。/2027S はその年だけのもの
# IDを取り違えると別のロールが付く。変えたらDiscordの設定画面で名前と照らし合わせる
ROLE_LT_IPPAN=
ROLE_COMMUNITY=
ROLE_COMMUNITY_YEAR=
ROLE_COMMUNITY_LT=
ROLE_SPONSOR=
ROLE_SPONSOR_YEAR=
ROLE_SPONSOR_LT=

# 回答を集めたスプレッドシートのID。URL の /d/ と /edit の間
SPREADSHEET_ID=

# サービスアカウントの鍵。secrets/ に置いたファイルを指す
GOOGLE_SERVICE_ACCOUNT_FILE=

# 何秒ごとに見に行くか
POLL_INTERVAL_SECONDS=300

# 試すときだけ使う。ここに書いた受付番号の行しか処理しない
# 空にすると全部の行を処理する。カンマで複数書ける
# 例: ONLY_NUMBERS=TEST-1,TEST-2,TEST-3
ONLY_NUMBERS=
